{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_PRIVATE_DESTINATION_BUCKET/surface/session.json",
        "arn:aws:s3:::REPLACE_WITH_PRIVATE_DESTINATION_BUCKET/surface/command.json"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_PRIVATE_DESTINATION_BUCKET/surface/command.json"
    }
  ]
}
