include LICENSE README.md
recursive-include pi *.py *.service
recursive-include examples *.json *.yaml
recursive-include docs *.md *.png
recursive-include tests *.py
recursive-exclude * __pycache__
global-exclude *.pyc *.local.json
recursive-include scripts *.sh *.py

recursive-include pi/assets *.png *.json *.md

recursive-include .agents/skills *.md *.yaml
recursive-include docs *.txt

recursive-exclude pi/assets/crests *
recursive-exclude pi/assets/app-logos *
exclude okabebot/assets/teams.json okabebot/assets/crests.json
